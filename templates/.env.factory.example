# Factory 2.0 — environment variables
# Copy relevant lines to your project .env (never commit actual values)

# ── Linear sync ───────────────────────────────────────────────────────────────
# Required when factory.config.yaml linear.enabled: true
# Get from: Linear → Settings → API → Personal API Keys
LINEAR_API_KEY=lin_api_xxxxxxxxxxxx

# State IDs — get via /linear-sync setup instructions
# Run: curl ... { teams { nodes { id name } } } to find team_id
# Run: curl ... { team(id: "...") { states { nodes { id name type } } } }
LINEAR_DONE_STATE_ID=        # state with type: completed
LINEAR_TODO_STATE_ID=        # state with type: unstarted
LINEAR_IN_PROGRESS_STATE_ID= # state with type: started

# ── Pi + Cursor shared model gateway ─────────────────────────────────────────
# Recommended: OpenRouter as shared gateway for both Pi and Cursor chat panel.
# Pi:    export OPENROUTER_API_KEY below
# Cursor: Settings → Models → Override OpenAI Base URL → https://openrouter.ai/api/v1
#         + paste same key as "OpenAI API Key"
# Note:  Cursor's Composer/agent/autocomplete stay on Cursor's own backend regardless.
OPENROUTER_API_KEY=sk-or-v1-...

# Alternative A: Claude Pro/Max subscription → /login inside Pi (no env var needed)
# Alternative B: Cloudflare AI Gateway (caching + observability + rate limiting)
# CLOUDFLARE_API_KEY=...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_GATEWAY_ID=factory-pi    # create at dash.cloudflare.com → AI → AI Gateway

# Direct provider keys (use when not using a gateway)
# ANTHROPIC_API_KEY=sk-ant-...

# ── ultimate-pi web retrieval subagents ───────────────────────────────────────
# Synced by scripts/sync-pi-config.sh if missing from .env
HARNESS_WEB_FAST_MODEL=openrouter/openrouter/owl-alpha
HARNESS_WEB_EXPANDER_MODEL=openrouter/tencent/hy3-preview
HARNESS_WEB_QUALITY_MODEL=openrouter/z-ai/glm-5.2
